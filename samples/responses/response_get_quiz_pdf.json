{"statusCode": 200, "headers": {"Content-Type": "application/json", "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Headers": "*", "Access-Control-Allow-Methods": "OPTIONS,POST,GET"}, "body": "{\"quiz_id\": \"quiz_a48923a88aeb\", \"title\": \"Biology Chapter 1: The Study of Life - \u5c0f\u30c6\u30b9\u30c8\", \"questions\": [{\"question_id\": \"q1\", \"question\": \"\u751f\u7269\u5b66\u306e\u5b9a\u7fa9\u3068\u3057\u3066\u6700\u3082\u9069\u5207\u306a\u3082\u306e\u306f\u3069\u308c\u304b\u3002\", \"choices\": [\"\u751f\u547d\u306e\u7814\u7a76\u3067\u3042\u308a\u3001\u7d30\u80de\u304b\u3089\u751f\u614b\u7cfb\u307e\u3067\u5e45\u5e83\u3044\u7bc4\u56f2\u3092\u5bfe\u8c61\u3068\u3059\u308b\", \"\u4e3b\u306b\u9855\u5fae\u93e1\u3092\u4f7f\u7528\u3057\u3066\u5fae\u751f\u7269\u3092\u7814\u7a76\u3059\u308b\u5b66\u554f\", \"\u5730\u7403\u4e0a\u306e\u3059\u3079\u3066\u306e\u751f\u7269\u306e\u5206\u985e\u3068\u547d\u540d\u3092\u884c\u3046\u5b66\u554f\", \"\u4eba\u9593\u306e\u5065\u5eb7\u3068\u75c5\u6c17\u306e\u6cbb\u7642\u65b9\u6cd5\u306e\u307f\u3092\u7814\u7a76\u3059\u308b\u5b66\u554f\"]}, {\"question_id\": \"q2\", \"question\": \"\u5e30\u7d0d\u7684\u63a8\u8ad6\uff08inductive reasoning\uff09\u3068\u6f14\u7e79\u7684\u63a8\u8ad6\uff08deductive reasoning\uff09\u306e\u4e3b\u306a\u9055\u3044\u306f\u4f55\u304b\u3002\", \"choices\": [\"\u5e30\u7d0d\u7684\u63a8\u8ad6\u306f\u4e00\u822c\u539f\u5247\u304b\u3089\u7279\u5b9a\u306e\u7d50\u679c\u3092\u4e88\u6e2c\u3057\u3001\u6f14\u7e79\u7684\u63a8\u8ad6\u306f\u591a\u304f\u306e\u89b3\u5bdf\u304b\u3089\u4e00\u822c\u7684\u306a\u7d50\u8ad6\u306b\u5230\u9054\u3059\u308b\", \"\u5e30\u7d0d\u7684\u63a8\u8ad6\u306f\u591a\u304f\u306e\u89b3\u5bdf\u304b\u3089\u4e00\u822c\u7684\u306a\u7d50\u8ad6\u306b\u5230\u9054\u3057\u3001\u6f14\u7e79\u7684\u63a8\u8ad6\u306f\u4e00\u822c\u539f\u5247\u304b\u3089\u7279\u5b9a\u306e\u7d50\u679c\u3092\u4e88\u6e2c\u3059\u308b\", \"\u5e30\u7d0d\u7684\u63a8\u8ad6\u306f\u5b9f\u9a13\u306e\u307f\u306b\u57fa\u3065\u304d\u3001\u6f14\u7e79\u7684\u63a8\u8ad6\u306f\u89b3\u5bdf\u306e\u307f\u306b\u57fa\u3065\u304f\", \"\u5e30\u7d0d\u7684\u63a8\u8ad6\u306f\u7269\u7406\u5b66\u3067\u4f7f\u7528\u3055\u308c\u3001\u6f14\u7e79\u7684\u63a8\u8ad6\u306f\u751f\u7269\u5b66\u3067\u306e\u307f\u4f7f\u7528\u3055\u308c\u308b\"]}, {\"question_id\": \"q3\", \"question\": \"\u81ea\u7136\u79d1\u5b66\u306b\u542b\u307e\u308c\u308b\u5206\u91ce\u3068\u3057\u3066\u3001\u8b1b\u7fa9\u5185\u5bb9\u3067\u4f8b\u793a\u3055\u308c\u3066\u3044\u306a\u3044\u3082\u306e\u306f\u3069\u308c\u304b\u3002\", \"choices\": [\"\u5929\u6587\u5b66\u3068\u5316\u5b66\", \"\u7269\u7406\u5b66\u3068\u5730\u8cea\u5b66\", \"\u7d4c\u6e08\u5b66\u3068\u793e\u4f1a\u5b66\", \"\u751f\u7269\u5b66\u3068\u6570\u5b66\"]}]}"}