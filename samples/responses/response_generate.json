{"statusCode": 200, "headers": {"Content-Type": "application/json", "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Headers": "*", "Access-Control-Allow-Methods": "OPTIONS,POST,GET"}, "body": "{\"quiz_id\": \"quiz_55d6aaa65f3c\", \"title\": \"\u751f\u6210AI\u5165\u9580\", \"created_at\": \"2026-07-09T06:56:26.860367+00:00\", \"questions\": [{\"question_id\": \"q1\", \"question\": \"\u5927\u898f\u6a21\u8a00\u8a9e\u30e2\u30c7\u30eb\u304c\u81ea\u7136\u306a\u6587\u7ae0\u3092\u751f\u6210\u3059\u308b\u4ed5\u7d44\u307f\u3068\u3057\u3066\u3001\u6700\u3082\u9069\u5207\u306a\u3082\u306e\u306f\u3069\u308c\u304b\u3002\", \"choices\": [\"\u5165\u529b\u3055\u308c\u305f\u6587\u7ae0\u306e\u6587\u8108\u3092\u7406\u89e3\u3057\u3001\u6b21\u306b\u7d9a\u304f\u5358\u8a9e\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u3067\u751f\u6210\u3059\u308b\", \"\u3042\u3089\u304b\u3058\u3081\u30d7\u30ed\u30b0\u30e9\u30e0\u3055\u308c\u305f\u30eb\u30fc\u30eb\u306b\u5f93\u3063\u3066\u6587\u7ae0\u3092\u7d44\u307f\u7acb\u3066\u308b\", \"\u30e9\u30f3\u30c0\u30e0\u306b\u5358\u8a9e\u3092\u9078\u629e\u3057\u3066\u6587\u7ae0\u3092\u751f\u6210\u3059\u308b\", \"\u4eba\u9593\u304c\u624b\u52d5\u3067\u4f5c\u6210\u3057\u305f\u6587\u7ae0\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\"], \"correct_answer\": 0, \"explanation\": \"\u5927\u898f\u6a21\u8a00\u8a9e\u30e2\u30c7\u30eb\u306f\u3001\u5165\u529b\u3055\u308c\u305f\u6587\u7ae0\u306e\u6587\u8108\u3092\u7406\u89e3\u3057\u3001\u6b21\u306b\u7d9a\u304f\u5358\u8a9e\u3092\u4e88\u6e2c\u3059\u308b\u3053\u3068\u3067\u81ea\u7136\u306a\u6587\u7ae0\u3092\u751f\u6210\u3057\u307e\u3059\u3002\u3053\u308c\u304c\u8b1b\u7fa9\u5185\u5bb9\u3067\u660e\u8a18\u3055\u308c\u3066\u3044\u308b\u751f\u6210\u306e\u4ed5\u7d44\u307f\u3067\u3059\u3002\"}, {\"question_id\": \"q2\", \"question\": \"\u751f\u6210AI\u304c\u8aa4\u3063\u305f\u60c5\u5831\u3092\u3082\u3063\u3068\u3082\u3089\u3057\u304f\u51fa\u529b\u3059\u308b\u73fe\u8c61\u3092\u4f55\u3068\u547c\u3076\u304b\u3002\", \"choices\": [\"\u30d0\u30a4\u30a2\u30b9\", \"\u30cf\u30eb\u30b7\u30cd\u30fc\u30b7\u30e7\u30f3\", \"\u30aa\u30fc\u30d0\u30fc\u30d5\u30a3\u30c3\u30c6\u30a3\u30f3\u30b0\", \"\u30ce\u30a4\u30ba\"], \"correct_answer\": 1, \"explanation\": \"\u8b1b\u7fa9\u5185\u5bb9\u3067\u3001\u751f\u6210AI\u304c\u8aa4\u3063\u305f\u60c5\u5831\u3092\u3082\u3063\u3068\u3082\u3089\u3057\u304f\u51fa\u529b\u3059\u308b\u73fe\u8c61\u306f\u300c\u30cf\u30eb\u30b7\u30cd\u30fc\u30b7\u30e7\u30f3\u300d\u3068\u547c\u3070\u308c\u308b\u3053\u3068\u304c\u660e\u8a18\u3055\u308c\u3066\u3044\u307e\u3059\u3002\"}, {\"question_id\": \"q3\", \"question\": \"\u5927\u5b66\u6559\u80b2\u306b\u304a\u3051\u308b\u751f\u6210AI\u306e\u5fdc\u7528\u4f8b\u3068\u3057\u3066\u3001\u8b1b\u7fa9\u5185\u5bb9\u306b\u6319\u3052\u3089\u308c\u3066\u3044\u306a\u3044\u3082\u306e\u306f\u3069\u308c\u304b\u3002\", \"choices\": [\"\u6559\u6750\u4f5c\u6210\", \"\u8cea\u554f\u5fdc\u7b54\", \"\u30ec\u30dd\u30fc\u30c8\u306e\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\", \"\u5b66\u751f\u306e\u6210\u7e3e\u8a55\u4fa1\u306e\u81ea\u52d5\u5224\u5b9a\"], \"correct_answer\": 3, \"explanation\": \"\u8b1b\u7fa9\u5185\u5bb9\u3067\u306f\u3001\u6559\u6750\u4f5c\u6210\u3001\u8cea\u554f\u5fdc\u7b54\u3001\u30ec\u30dd\u30fc\u30c8\u306e\u30d5\u30a3\u30fc\u30c9\u30d0\u30c3\u30af\u3001\u5c0f\u30c6\u30b9\u30c8\u751f\u6210\u304c\u5fdc\u7528\u4f8b\u3068\u3057\u3066\u6319\u3052\u3089\u308c\u3066\u3044\u307e\u3059\u3002\u5b66\u751f\u306e\u6210\u7e3e\u8a55\u4fa1\u306e\u81ea\u52d5\u5224\u5b9a\u306f\u8b1b\u7fa9\u5185\u5bb9\u306b\u542b\u307e\u308c\u3066\u3044\u307e\u305b\u3093\u3002\"}]}"}